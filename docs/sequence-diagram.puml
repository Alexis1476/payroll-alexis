@startuml
'https://plantuml.com/sequence-diagram

autonumber

== Get all employees ==

actor Actor as actor
actor -> PayrollApplication : curl localhost:8080/api/v1/employees
PayrollApplication -> EmployeeController : /api/v1/employees
EmployeeController -> EmployeeRepository : findAll()
database Database as db
EmployeeRepository -> db : Get data
db --> EmployeeRepository :  List<Employee>
EmployeeRepository --> EmployeeController
EmployeeController --> PayrollApplication
PayrollApplication --> actor : JSON data
@enduml